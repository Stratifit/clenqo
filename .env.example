# CLENQO environment template — copy to .env.local and fill in.
# Never commit real credentials.

# --- Supabase (anon key is public; service-role key is server-only) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Must never reach browser code (SECURITY.md, PROJECT_STRUCTURE.md §128–130):
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Server-only privileged Postgres connection for domain transactions.
# Preferred: the Supabase pooler connection string (session or transaction
# mode). If unset, the server derives a direct connection from the URL +
# service-role key.
SUPABASE_DB_URL=postgresql://postgres:...@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
